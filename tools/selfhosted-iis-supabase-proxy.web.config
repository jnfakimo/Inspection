<?xml version="1.0" encoding="UTF-8"?>
<!--
  自架站台（1.34.250.22:5057）的 Supabase 反向代理範本
  ==================================================================
  目的：讓瀏覽器對「本站 origin」發出的 Supabase 呼叫
        （/auth、/rest、/storage、/realtime、/functions）
        由 IIS 轉發到本機 Supabase 的 Kong 閘道。

  ※ 這台的 Kong 走 HTTPS：http://…:54321 會回 Kong 的
     「400 The plain HTTP request was sent to HTTPS port」。目標必須寫
     https://127.0.0.1:54321。（2026-09-05 於開發機實測）

  為什麼需要：web/lib/config.ts 與 system/supabase-config.js 讓自架站台的
        SUPABASE_URL 沿用目前 origin（https://1.34.250.22:5057），前端所有
        Supabase 呼叫都打向本站。若 IIS 沒有把 /auth、/rest 轉到本機 54321，
        這兩條路徑會落到 IIS 預設處理並回純文字「401 Unauthorized」，
        登入就會卡在 setSession。

  2026-09-05 實測現況（外部對 https://1.34.250.22:5057 探測）：
    /auth、/rest、/realtime  → IIS 自己的純文字 401（完全沒反代）
    /functions、/storage     → **被轉到雲端專案**，不是本機
                               （回應帶 x-envoy-upstream-service-time，
                                 且 access-control-allow-origin 是
                                 https://jnfakimo.github.io）
  五個前綴必須指向同一個後端，否則 username-login 會拿雲端資料庫驗身分、
  發出雲端 session，再被本機 GoTrue／PostgREST 拒絕。本檔一律指向本機。

  前提（在該台 IIS 主機安裝一次）：
    1. 「URL Rewrite 2.1」模組
    2. 「Application Request Routing 3.0」模組（ARR）
    3. IIS 管理員 → 伺服器節點 → Application Request Routing Cache
       → 右側 Server Proxy Settings → 勾選「Enable proxy」→ 套用
       （沒有這一步，Rewrite 到 http://localhost 會回 404.4 或 500.52）

  套用方式：把下方 <rewrite> 區塊「合併」進站台根目錄現有的 web.config，
        不要整檔覆蓋——既有的 Next.js 靜態路由、安全標頭（HSTS、X-Frame-Options
        等）與預設文件設定都要保留。若站台目前沒有 web.config，才可整檔採用本檔
        （並自行補回原有的安全標頭）。

  驗證：套用後在該台或外部執行
        curl -sk -o /dev/null -w "%{http_code}\n" \
          -X POST -H "apikey: <本機 anon key>" -H "Content-Type: application/json" \
          -d '{"email":"__probe__@example.invalid","password":"x"}' \
          "https://1.34.250.22:5057/auth/v1/token?grant_type=password"
        修好後應回 400（GoTrue 的 invalid_credentials JSON），
        不再是 IIS 的純文字 401。

  註：本機 GoTrue 對 anon key 並不驗簽——雲端與本機兩把 key 都會得到同一個
      400 invalid_credentials（2026-09-05 實測）。所以 anon key 不對並不是
      登入失敗的原因，反代缺漏才是。

  自動化：`tools/selfhosted-restore-login.ps1` 會偵測既有規則、備份 web.config、
      移除指向雲端的規則並把本規則插到第一條，最後跑完整驗證。
      先不加參數空跑看計畫，再加 -Apply 實際套用。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!--
          這五個前綴一律轉給本機 Supabase Kong 閘道，保留原路徑與查詢字串。
          擺在其他規則之前，並 stopProcessing，避免被 Next.js 的靜態路由接走。
        -->
        <rule name="Supabase reverse proxy" stopProcessing="true">
          <match url="^(auth|rest|storage|realtime|functions)/(.*)" />
          <action type="Rewrite" url="https://127.0.0.1:54321/{R:1}/{R:2}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!--
      /realtime 是 WebSocket。IIS 需安裝「WebSocket Protocol」功能，
      ARR 才會把 Upgrade 交握一併轉發；一般登入不需要 realtime，
      這條可在確認登入通了之後再驗。
    -->
  </system.webServer>
</configuration>
