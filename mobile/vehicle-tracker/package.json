{
  "name": "beinong-vehicle-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:storage": "node --test test/storage.test.cjs",
    "postinstall": "node scripts/patch-deepmerge.cjs",
    "test:security-deps": "node scripts/patch-deepmerge.cjs --check && node --test test/security-deps.test.cjs",
    "pretypecheck": "node scripts/patch-deepmerge.cjs --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.116.0",
    "expo": "57.0.20",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.4",
    "expo-dev-client": "~57.0.18",
    "expo-location": "57.0.16",
    "expo-secure-store": "57.0.4",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "57.0.16",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "3.5.1",
    "react-native-url-polyfill": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@expo/cli": {
      "zod": "4.6.7"
    }
  }
}
